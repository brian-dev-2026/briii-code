	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7F8C98", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "variable.language", "constant.language"], "settings": { "foreground": "#FF7AB2", "fontStyle": "bold" } },
		{ "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#FFFFFFD9", "fontStyle": "" } },
		{ "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#FF8170" } },
		{ "scope": ["constant.character", "constant.character.escape"], "settings": { "foreground": "#D9C97C" } },
		{ "scope": ["constant.numeric"], "settings": { "foreground": "#D9C97C" } },
		{ "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.interface"], "settings": { "foreground": "#5DD8FF" } },
		{ "scope": ["support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#DABAFF" } },
		{ "scope": ["entity.name.function", "meta.definition.method entity.name.function"], "settings": { "foreground": "#41A1C0" } },
		{ "scope": ["support.function", "meta.function-call entity.name.function", "variable.function"], "settings": { "foreground": "#B281EB" } },
		{ "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#67B7A4" } },
		{ "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#FFFFFFD9" } },
		{ "scope": ["meta.preprocessor", "keyword.control.directive", "keyword.control.import", "keyword.control.export"], "settings": { "foreground": "#FD8F3F" } },
		{ "scope": ["entity.other.attribute-name", "meta.decorator", "punctuation.decorator"], "settings": { "foreground": "#BF8555" } },
		{ "scope": ["entity.name.tag"], "settings": { "foreground": "#FF7AB2" } },
		{ "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#6699FF" } },
		{ "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#5DD8FF", "fontStyle": "bold" } },
		{ "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
		{ "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
		{ "scope": ["markup.inserted"], "settings": { "foreground": "#30D158" } },
		{ "scope": ["markup.deleted"], "settings": { "foreground": "#FF453A" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#FF453A" } }
	],
	"semanticTokenColors": {
		"class": "#5DD8FF",
		"interface": "#5DD8FF",
		"enum": "#5DD8FF",
		"type": "#DABAFF",
		"function.declaration": "#41A1C0",
		"method.declaration": "#41A1C0",
		"function": "#B281EB",
		"method": "#B281EB",
		"property": "#67B7A4",
		"parameter": "#FFFFFFD9",
		"variable": "#FFFFFFD9",
		"variable.readonly": "#FFFFFFD9",
		"enumMember": "#D9C97C",
		"decorator": "#BF8555",
		"macro": "#FD8F3F"
	}
}
