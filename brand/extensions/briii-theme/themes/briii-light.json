	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5D6C79", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "variable.language", "constant.language"], "settings": { "foreground": "#9B2393", "fontStyle": "bold" } },
		{ "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#000000D9", "fontStyle": "" } },
		{ "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#C41A16" } },
		{ "scope": ["constant.character", "constant.character.escape"], "settings": { "foreground": "#1C00CF" } },
		{ "scope": ["constant.numeric"], "settings": { "foreground": "#1C00CF" } },
		{ "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.interface"], "settings": { "foreground": "#0B4F79" } },
		{ "scope": ["support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#3900A0" } },
		{ "scope": ["entity.name.function", "meta.definition.method entity.name.function"], "settings": { "foreground": "#0F68A0" } },
		{ "scope": ["support.function", "meta.function-call entity.name.function", "variable.function"], "settings": { "foreground": "#6C36A9" } },
		{ "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#326D74" } },
		{ "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#000000D9" } },
		{ "scope": ["meta.preprocessor", "keyword.control.directive", "keyword.control.import", "keyword.control.export"], "settings": { "foreground": "#643820" } },
		{ "scope": ["entity.other.attribute-name", "meta.decorator", "punctuation.decorator"], "settings": { "foreground": "#815F03" } },
		{ "scope": ["entity.name.tag"], "settings": { "foreground": "#9B2393" } },
		{ "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#0E0EFF" } },
		{ "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#0B4F79", "fontStyle": "bold" } },
		{ "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
		{ "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
		{ "scope": ["markup.inserted"], "settings": { "foreground": "#248A3D" } },
		{ "scope": ["markup.deleted"], "settings": { "foreground": "#D70015" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#D70015" } }
	],
	"semanticTokenColors": {
		"class": "#0B4F79",
		"interface": "#0B4F79",
		"enum": "#0B4F79",
		"type": "#3900A0",
		"function.declaration": "#0F68A0",
		"method.declaration": "#0F68A0",
		"function": "#6C36A9",
		"method": "#6C36A9",
		"property": "#326D74",
		"parameter": "#000000D9",
		"variable": "#000000D9",
		"variable.readonly": "#000000D9",
		"enumMember": "#1C00CF",
		"decorator": "#815F03",
		"macro": "#643820"
	}
}
